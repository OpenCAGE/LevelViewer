; Engine configuration file.
; Godot 4.3+ Level Viewer for OpenCAGE Commands Editor.

config_version=5

[application]

config/name="CathodeEditorGodot"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "C#")
config/icon="res://icon.svg"

[dotnet]

project/assembly_name="CathodeEditorGodot"

[rendering]

renderer/rendering_method="forward_plus"
occlusion_culling/use_occlusion_culling=false
