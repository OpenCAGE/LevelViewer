<Project Sdk="Godot.NET.Sdk/4.7.1">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>CathodeEditorGodot</RootNamespace>
    <AssemblyName>CathodeEditorGodot</AssemblyName>
    <DefineConstants>GODOT</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- *.Template.cs files hold raw text (HTML/CSS) inside #if-disabled regions; C# still scans skipped
         lines starting with '#' as preprocessor directives, so they cannot be compiled here at all.
         SoundNodeNetworkGenerator's body is #if'd out for GODOT but its usings (Radiosity/NanoRT) are not. -->
    <Compile Include="..\..\..\CathodeLib\CathodeLib\Scripts\**\*.cs" Exclude="..\..\..\CathodeLib\CathodeLib\Scripts\Instancing.cs;..\..\..\CathodeLib\CathodeLib\Scripts\**\*.Template.cs;..\..\..\CathodeLib\CathodeLib\Scripts\CATHODE\Sound Network\SoundNodeNetworkGenerator.cs" Link="CathodeLib\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\..\CathodeLib\AlienBML\BML.cs" Link="CathodeLib\Scripts\CATHODE\BML.cs" />
    <Compile Include="..\..\..\CathodeLib\CathodeLib\Properties\Resources.Designer.cs" Link="CathodeLib\Properties\Resources.Designer.cs">
      <DependentUpon>Resources.resx</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <!-- CathodeLib's info.dat (the vanilla entity, enum, pin and name tables) is embedded through this resx, so the viewer
         always has the copy that matches the CathodeLib it was built with. Nothing is shipped beside the exe for it.
         LogicalName: left to the SDK, the resource takes this project's namespace and the link's folders
         (CathodeEditorGodot.CathodeLib.Properties.Resources), and CathodeLib's Resources class - which asks for
         CathodeLib.Properties.Resources - never finds it. -->
    <EmbeddedResource Include="..\..\..\CathodeLib\CathodeLib\Properties\Resources.resx" Link="CathodeLib\Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <LogicalName>CathodeLib.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AstcSharp" Version="0.9.8" />
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Buffers" Version="4.5.1" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Numerics.Vectors" Version="4.5.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="5.0.0" />
    <PackageReference Include="xxHash.NET" Version="1.0.2" />
  </ItemGroup>

</Project>
